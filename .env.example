# Copy to .env with: ./scripts/init-env.sh https://whatsapp.example.com
PUBLIC_BASE_URL=https://whatsapp.example.com
API_TOKEN=generated-by-init-script
SETUP_TOKEN=generated-by-init-script
SETUP_ENABLED=true
LISTEN_ADDR=0.0.0.0:8080
DATABASE_PATH=/data/bridge.db
GROUP_MODE=pinned
GROUP_ALLOWLIST=[]
DEBUG=false

# Caddy profile: public DNS must point at this host; ports 80/443 must be open.
DOMAIN=whatsapp.example.com

# Cloudflare profile: create a remotely managed tunnel whose public hostname
# routes to http://bridge:8080. Keep the token only in .env.
TUNNEL_TOKEN=
